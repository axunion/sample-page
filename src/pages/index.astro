---
import Cases from "../components/sections/Cases.astro";
import Clients from "../components/sections/Clients.astro";
import CompanyProfile from "../components/sections/CompanyProfile.astro";
import Contact from "../components/sections/Contact.astro";
import Hero from "../components/sections/Hero.astro";
import Philosophy from "../components/sections/Philosophy.astro";
import RecruitBanner from "../components/sections/RecruitBanner.astro";
import Services from "../components/sections/Services.astro";
import Stats from "../components/sections/Stats.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={`${site.name}｜${site.tagline}`} description={site.description}>
  <Hero />
  <Philosophy />
  <Services />
  <Cases />
  <Stats />
  <Clients />
  <CompanyProfile />
  <Contact />
  <RecruitBanner />
</BaseLayout>
