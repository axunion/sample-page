---
import Clients from "../components/sections/Clients.astro";
import CompanyProfile from "../components/sections/CompanyProfile.astro";
import Contact from "../components/sections/Contact.astro";
import Hero from "../components/sections/Hero.astro";
import Philosophy from "../components/sections/Philosophy.astro";
import Services from "../components/sections/Services.astro";
import Strengths from "../components/sections/Strengths.astro";
import Vision from "../components/sections/Vision.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={`${site.name}｜${site.tagline}`} description={site.description}>
  <Hero />
  <Philosophy />
  <Strengths />
  <Services />
  <Clients />
  <Vision />
  <CompanyProfile />
  <Contact />
</BaseLayout>
