---
import { company } from "../data/company";
import { nav } from "../data/nav";
import { site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="footer section--dark">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__name">{site.name}</p>
      <p class="footer__name-en label-latin">{site.nameEn}</p>
    </div>

    <nav class="footer__nav" aria-label="サイトマップ">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p>{company.address.region}{company.address.locality}{company.address.street}</p>
    <p>&copy; {year} {site.name}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-16) var(--space-8);
  }

  .footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8);
    padding-block-end: var(--space-8);
    border-bottom: var(--rule-hair) solid var(--color-border);
  }

  .footer__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .footer__name-en {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__nav a {
    text-decoration: none;
    font-size: var(--text-sm);

    &:hover {
      color: var(--color-accent);
    }
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding-block-start: var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .footer__bottom p {
    margin: 0;
  }
</style>
