---
import Logo from "../assets/logo.svg";
import { nav } from "../data/nav";
---

<header class="header section--dark">
  <div class="container header__bar">
    <a class="header__brand" href={import.meta.env.BASE_URL} aria-label="株式会社紬 トップへ">
      <Logo width="160" height="32" />
    </a>

    <nav class="header__nav" aria-label="サイト内">
      <ul class="list-reset">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--primary header__cta" href="#contact">お問い合わせ</a>

    <details class="header__disclosure">
      <summary class="header__disclosure-toggle" aria-label="メニューを開く">
        <svg width="20" height="14" viewBox="0 0 20 14" aria-hidden="true">
          <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </summary>
      <div class="header__disclosure-panel">
        <ul class="list-reset">
          {
            nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--primary" href="#contact">お問い合わせ</a>
      </div>
    </details>
  </div>
</header>

<script>
  // The page's only script: close the mobile disclosure after a nav choice.
  const disclosure = document.querySelector<HTMLDetailsElement>(".header__disclosure");
  disclosure?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      disclosure.open = false;
    });
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    block-size: var(--header-height);
  }

  .header__brand {
    display: flex;
    align-items: center;
    margin-inline-end: auto;
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-6);
  }

  .header__nav a {
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-jp);

    &:hover {
      color: var(--color-accent);
    }
  }

  .header__cta {
    display: none;
  }

  .header__disclosure {
    margin-inline-start: auto;
  }

  .header__disclosure-toggle {
    display: flex;
    align-items: center;
    padding: var(--space-2);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }
  }

  .header__disclosure-panel {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--gutter);
    background: var(--color-bg);
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .header__disclosure-panel ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .header__disclosure-panel a {
    text-decoration: none;
  }

  @media (width >= 64rem) {
    .header__nav,
    .header__cta {
      display: flex;
    }

    .header__disclosure {
      display: none;
    }
  }
</style>
