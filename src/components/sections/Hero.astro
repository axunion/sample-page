---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/hero-concierge.jpg";
---

<section class="hero section--dark" aria-labelledby="hero-heading">
  <Image
    class="hero__image"
    src={heroImage}
    alt=""
    layout="full-width"
    priority
    format="webp"
    quality={70}
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <p class="hero__vertical-label" aria-hidden="true">人が育つ現場をつくる</p>

  <div class="container hero__content">
    <p class="hero__eyebrow label-latin">TSUMUGI INC.</p>
    <h1 id="hero-heading" class="hero__title">その上質さは、<br />現場がつくる。</h1>
    <p class="hero__lead">
      ホテル・フィットネス・ウェルネス業界の現場運営と人材育成を、<br />
      経験に裏打ちされたノウハウで支援します。
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">企業のご担当者さまへ</a>
      <a class="btn btn--ghost" href="#recruit">採用情報を見る</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-block-size: min(88svh, 52rem);
    padding-block: 0;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 20%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(11 21 36 / 92%) 0%,
      rgb(11 21 36 / 70%) 35%,
      rgb(11 21 36 / 25%) 65%,
      rgb(11 21 36 / 10%) 100%
    );
  }

  .hero__content {
    position: relative;
    padding-block: var(--space-16) var(--space-20);
  }

  .hero__vertical-label {
    display: none;
    position: absolute;
    /* Physical properties on purpose: writing-mode below flips the meaning
       of the inset-block and inset-inline shorthands on this element (its
       own vertical-rl axis, not the page's), which reliably surprises the
       next reader. */
    top: var(--space-16);
    right: var(--gutter);
    block-size: 14rem;
    writing-mode: vertical-rl;
    margin: 0;
    color: var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-jp);
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-accent);
  }

  .hero__title {
    margin: 0 0 var(--space-6);
    max-width: 20ch;
    font-size: var(--text-3xl);
    font-weight: 500;
    letter-spacing: var(--tracking-jp);
  }

  .hero__lead {
    max-width: var(--width-text);
    margin: 0 0 var(--space-8);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (width >= 48rem) {
    .hero__vertical-label {
      display: block;
    }
  }
</style>
