---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/hero.jpg";
import { site } from "../../data/site";
---

<!-- The photo carries the brand name and tagline in its pixels, so the hero is
     the image alone, shown uncropped. The <h1> wraps it so the page keeps a
     heading, named by the image's alt text. -->
<section class="hero section--dark" aria-labelledby="hero-heading">
  <h1 id="hero-heading" class="hero__heading">
    <Image
      class="hero__image"
      src={heroImage}
      alt={`${site.name} — HOTEL FITNESS & WELLNESS MANAGEMENT`}
      layout="full-width"
      priority
      format="webp"
      quality={80}
    />
  </h1>
</section>

<style>
  .hero {
    padding-block: 0;
  }

  .hero__heading {
    margin: 0;
    overflow: hidden;
  }

  .hero__image {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  /* Scale only, never opacity: the image may be the LCP element. The
     heading's overflow: hidden clips the oversized start frame. */
  @keyframes hero-image-settle {
    from {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__image {
      animation: hero-image-settle 2400ms var(--ease-entrance) backwards;
    }
  }
</style>
