---
import { Image } from "astro:assets";
import heroImage from "../../assets/images/hero-spa.jpg";
import { site } from "../../data/site";
---

<section class="hero section--dark" aria-labelledby="hero-heading">
  <Image
    class="hero__image"
    src={heroImage}
    alt=""
    layout="full-width"
    priority
    format="webp"
    quality={70}
  />
  <div class="hero__scrim" aria-hidden="true"></div>

  <p class="hero__vertical-label" aria-hidden="true">{site.tagline}</p>

  <div class="container hero__content">
    <p class="hero__eyebrow label-latin">MODESTY FIT LLC</p>
    <h1 id="hero-heading" class="hero__title">
      <span class="hero__title-line">{site.tagline}</span><span class="hero__phrase">実績が紡ぐ、</span><span class="hero__phrase">次世代の施設運営受託</span>
    </h1>
    <p class="hero__lead">
      真のホスピタリティは、完璧なオペレーションから生まれる。<br />
      世界のVIPを魅了する品質を、スマートなコストマネジメントで。
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">企業のご担当者さまへ</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-block-size: min(88svh, 52rem);
    padding-block: 0;
    overflow: hidden;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--navy-900) 92%, transparent) 0%,
      color-mix(in srgb, var(--navy-900) 70%, transparent) 35%,
      color-mix(in srgb, var(--navy-900) 25%, transparent) 65%,
      color-mix(in srgb, var(--navy-900) 10%, transparent) 100%
    );
  }

  .hero__content {
    position: relative;
    /* As a flex item the container would shrink to its content and, with its
       auto margins, drift away from the header's left edge. */
    inline-size: 100%;
    padding-block: var(--space-10) var(--space-12);
  }

  @media (width >= 48rem) {
    .hero__content {
      padding-block: var(--space-16) var(--space-20);
    }
  }

  .hero__vertical-label {
    display: none;
    position: absolute;
    /* Physical properties on purpose: writing-mode below flips the meaning
       of the inset-block and inset-inline shorthands on this element (its
       own vertical-rl axis, not the page's), which reliably surprises the
       next reader. */
    top: var(--space-16);
    right: var(--gutter);
    block-size: 14rem;
    writing-mode: vertical-rl;
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-jp);
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--color-accent);
  }

  .hero__title {
    margin: 0 0 var(--space-6);
    max-width: 24em;
    /* The first line is 13 characters and must never wrap, so the size is
       capped by what fits between the gutters (14 = 13 characters plus
       letter-spacing). */
    font-size: min(var(--text-3xl), calc((100vw - 2 * var(--gutter)) / 14));
    font-weight: 400;
    letter-spacing: var(--tracking-jp);
    text-wrap: balance;
  }

  .hero__title-line {
    display: block;
    white-space: nowrap;
  }

  /* Narrow screens break between phrases, never inside one. */
  .hero__phrase {
    display: inline-block;
  }

  .hero__lead {
    max-width: var(--width-text);
    margin: 0 0 var(--space-8);
    color: var(--color-text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (width >= 48rem) {
    .hero__vertical-label {
      display: block;
    }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* The <h1> is the LCP element: an element at opacity 0 does not count as
     painted, so it moves without fading. */
  @keyframes hero-settle {
    from {
      transform: translateY(10px);
    }
  }

  /* Scale only, never opacity: the image may be the LCP element. The
     section's overflow: hidden clips the oversized start frame. */
  @keyframes hero-image-settle {
    from {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__image {
      animation: hero-image-settle 2400ms var(--ease-entrance) backwards;
    }

    .hero__eyebrow,
    .hero__lead,
    .hero__actions,
    .hero__vertical-label {
      animation: hero-rise var(--duration-entrance) var(--ease-entrance) backwards;
    }

    .hero__title {
      animation: hero-settle var(--duration-entrance) var(--ease-entrance) backwards;
      animation-delay: 140ms;
    }

    .hero__eyebrow {
      animation-delay: 80ms;
    }

    .hero__lead {
      animation-delay: 240ms;
    }

    .hero__actions {
      animation-delay: 340ms;
    }

    .hero__vertical-label {
      animation-delay: 460ms;
    }
  }
</style>
