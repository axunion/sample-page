---
import { clients } from "../../data/clients";
import SectionHeading from "../SectionHeading.astro";

const groups = new Map<string, string[]>();
for (const client of clients) {
  const names = groups.get(client.category) ?? [];
  names.push(client.name);
  groups.set(client.category, names);
}
---

<section id="clients" class="section" aria-labelledby="clients-heading">
  <SectionHeading id="clients-heading" en="RESULTS" ja="受託実績" />

  <div class="container">
    <div class="reveal">
      {
        [...groups].map(([category, names]) => (
          <div class="clients__group">
            <p class="clients__category">{category}</p>
            <ul class="clients__list list-reset">
              {names.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <p class="clients__note">敬称略</p>
  </div>
</section>

<style>
  /* A two-column table: category on the left, facility names stacked on the
     right. Below the breakpoint the columns collapse into one. */
  .clients__group {
    display: grid;
    gap: var(--space-3) var(--space-8);
    padding-block: var(--space-6);
    border-top: var(--rule-hair) solid var(--color-rule);
  }

  .clients__group:last-child {
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }

  .clients__category {
    margin: 0;
    color: var(--color-accent);
    font-size: var(--text-sm);
    font-weight: 400;
    letter-spacing: var(--tracking-jp);
  }

  .clients__list {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text-muted);
  }

  @media (width >= 48rem) {
    .clients__group {
      grid-template-columns: 16rem 1fr;
    }
  }

  .clients__note {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }
</style>
